{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Next.js: Debug Server",
            "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/next",
            "runtimeArgs": ["dev"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"],
            "sourceMaps": true,
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!.next/**"
            ],
            "outFiles": [
                "${workspaceFolder}/.next/**/*.js"
            ]
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Next.js: Debug Client (Chrome)",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}",
            "sourceMaps": true,
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!.next/**"
            ]
        },
        {
            "type": "node",
            "request": "attach",
            "name": "Next.js: Attach to Server",
            "port": 9229,
            "cwd": "${workspaceFolder}",
            "sourceMaps": true,
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!.next/**"
            ],
            "outFiles": [
                "${workspaceFolder}/.next/**/*.js"
            ]
        }
    ]
}
